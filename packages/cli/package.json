{
  "name": "@repanel/cli",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "repanel": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/embed-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@repanel/contracts": "workspace:*",
    "@repanel/engine": "workspace:*"
  },
  "devDependencies": {
    "@repanel/runtime": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.23.12"
  }
}
