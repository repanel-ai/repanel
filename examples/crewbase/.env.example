# Runtime mode: development | test | production
NODE_ENV=development

# Port Crewbase listens on (RePanel's own API takes 3001)
PORT=3002

# Crewbase's database; matches the service in this directory's docker-compose.yml
DATABASE_URL=postgres://crewbase:crewbase@localhost:5433/crewbase

# Whichever secret RePanel signs with. Under `repanel dev` it is the one that
# run printed on startup; under a hosted project it is the project's action
# secret, copied from the console (Project → Agent access → action secret).
# Every request RePanel sends to /repanel/* is signed with it; see
# ../../docs/SIGNING.md. The value below is a throwaway so a fresh clone boots —
# replace it with the one the caller is actually using.
REPANEL_ACTION_SECRET=dev-only-not-a-real-secret
