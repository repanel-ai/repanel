# Runtime mode: development | test | production
NODE_ENV=development

# Port Crewbase listens on (RePanel's own API takes 3001)
PORT=3002

# Crewbase's database; matches the service in this directory's docker-compose.yml
DATABASE_URL=postgres://crewbase:crewbase@localhost:5433/crewbase

# The RePanel project's action secret, copied from the console
# (Project → Agent access → action secret). Every request RePanel sends to
# /repanel/* is signed with it; see ../../docs/SIGNING.md. The value below is a
# throwaway so a fresh clone boots — replace it before connecting a project.
REPANEL_ACTION_SECRET=dev-only-not-a-real-secret
