# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3001

# PostgreSQL connection string; matches the service in docker-compose.yml
DATABASE_URL=postgres://repanel:repanel@localhost:5432/repanel

# Where this API answers from outside the browser — the address an agent's MCP
# client dials.
API_URL=http://localhost:3001

# Where the console is served from. The MCP server sends an authoring agent
# here when a project still needs a database connection.
CONSOLE_URL=http://localhost:5173

# Where the rendered admin is served. With the console, it is also the pair of
# origins this API allows a browser to call it from.
RUNTIME_URL=http://localhost:5174

# Encrypts customer database connection strings at rest.
# Generate one with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
